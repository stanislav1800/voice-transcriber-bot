# Токен от @BotFather
BOT_TOKEN=

# Telegram ID, которым разрешён доступ (через запятую).
# Свой ID можно узнать, написав боту /start
ALLOWED_USERS=

# Модель Whisper: tiny | base | small (small требует ~600+ МБ RAM)
WHISPER_MODEL=base
# Язык: ru, en, ... или auto для автоопределения
WHISPER_LANGUAGE=ru
# 1 — быстрее, 5 — чуть точнее, но медленнее
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=1

# Максимальная длительность записи, минут
MAX_DURATION_MIN=10
# Максимум задач в очереди
MAX_QUEUE=10

LOG_LEVEL=INFO
