# Токен от @BotFather
BOT_TOKEN=

# Telegram ID, которым разрешён доступ (через запятую).
# Свой ID можно узнать, написав боту /start
ALLOWED_USERS=

# Модель распознавания (onnx-asr): gigaam-v3-e2e-rnnt (точнее) или gigaam-v3-e2e-ctc (чуть быстрее).
# e2e-модели сразу выдают текст с пунктуацией
ASR_MODEL=gigaam-v3-e2e-rnnt
# int8 — ~225 МБ на диске, меньше памяти; none — полная точность (~900 МБ, на 1 ГБ RAM не влезет)
ASR_QUANTIZATION=int8
CPU_THREADS=1

# Максимальная длительность записи, минут
MAX_DURATION_MIN=10
# Максимум задач в очереди
MAX_QUEUE=10

LOG_LEVEL=INFO
